{
  "name": "wecom-chatgpt-bot",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "desktop:build": "pwsh -NoProfile -ExecutionPolicy Bypass -File scripts/package-desktop.ps1",
    "desktop:dev": "pwsh -NoProfile -ExecutionPolicy Bypass -File scripts/desktop-dev.ps1",
    "dev": "node scripts/project-run.mjs dev",
    "start": "node scripts/project-run.mjs start",
    "stop": "node scripts/project-run.mjs tsx scripts/stop.ts",
    "build": "node scripts/project-run.mjs build",
    "check": "node scripts/project-run.mjs check",
    "test": "node scripts/project-run.mjs test",
    "test:python": "node scripts/project-run.mjs python",
    "setup": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/setup.ps1",
    "doctor": "node scripts/project-run.mjs tsx scripts/doctor.ts",
    "wechat:outbox": "node scripts/project-run.mjs tsx scripts/wechat-outbox.ts",
    "wechat:accessibility:build": "node scripts/project-run.mjs accessibility-build",
    "wechat:accessibility:check": "node scripts/project-run.mjs accessibility --check",
    "wechat:accessibility:test": "node scripts/project-run.mjs accessibility --self-test",
    "wechat:accessibility:enable": "node scripts/project-run.mjs tsx scripts/wechat-accessibility-enable.ts",
    "wechat:send:smoke": "node scripts/project-run.mjs tsx scripts/wechat-send-smoke.ts",
    "wechat:ocr:install": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/install-wechat-ocr.ps1",
    "wechat:build": "node scripts/project-run.mjs native",
    "wechat:probe": "node scripts/project-run.mjs tsx scripts/wechat-probe.ts",
    "wechat:inspect": "node scripts/project-run.mjs tsx scripts/wechat-inspect.ts",
    "wechat:ocr:inspect": "node scripts/project-run.mjs tsx scripts/wechat-ocr-inspect.ts",
    "wechat:select:inspect": "node scripts/project-run.mjs tsx scripts/wechat-select-inspect.ts",
    "wechat:resend:task": "node scripts/project-run.mjs tsx scripts/wechat-resend-task.ts",
    "wechat:poll": "node scripts/project-run.mjs tsx scripts/wechat-poll.ts",
    "wechat:snapshot": "node scripts/project-run.mjs tsx scripts/wechat-snapshot.ts",
    "chatgpt:smoke": "node scripts/project-run.mjs tsx scripts/chatgpt-smoke.ts",
    "playwright:install": "node scripts/project-run.mjs playwright"
  },
  "dependencies": {
    "@wecom/aibot-node-sdk": "^1.0.7",
    "better-sqlite3": "^12.4.1",
    "dotenv": "^17.2.2",
    "pino": "^9.9.4",
    "playwright": "^1.55.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^24.3.1",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  }
}
