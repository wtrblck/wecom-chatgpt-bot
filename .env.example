WECOM_ENABLED=false
WECOM_BOT_ID=
WECOM_BOT_SECRET=
CHATGPT_URL=https://chatgpt.com/
BROWSER_HEADLESS=false
BROWSER_PROFILE=./data/browser-profile
DATABASE_PATH=./data/bot.sqlite
LOG_LEVEL=info
# 调试日志文件：全部日志（含 debug 级）写入该文件，每次启动清空，只保留最后一次运行
# 设为空值可关闭文件日志
LOG_FILE=./latest.log
LOG_MESSAGE_CONTENT=false
CHATGPT_TIMEOUT_MS=180000
STREAM_UPDATE_INTERVAL_MS=800

# Windows 官方个人微信客户端渠道
WECHAT_ENABLED=true
WECHAT_ALLOWLIST=
WECHAT_REQUIRE_PREFIX=true
WECHAT_PREFIX=/gpt
WECHAT_PREFIX_ALIASES=@ChatBOT
# 逗号分隔的准确会话名；OCR 接近时强制映射为这里的名称
WECHAT_CANONICAL_NAMES=
WECHAT_READ_MODE=db
# uia: 严格控件发送。legacy: 显式启用旧视觉发送，无法核验时记录 uncertain。
WECHAT_SEND_MODE=uia
# 控件精确定位后使用的唯一提交动作，须与微信客户端的发送快捷键一致
WECHAT_SEND_ACTION=enter
WECHAT_DB_PYTHON_PATH=.venv-wechatdb/Scripts/python.exe
WECHAT_DB_DIR=
WECHAT_DB_ACCOUNT=
# DB 模式只监听这里明确指定的会话，逗号分隔
WECHAT_DB_CONVERSATIONS=
# 推荐使用独立 JSON 文件管理监听对象和每个会话的系统提示词；文件不存在时回退到上面的旧配置
WECHAT_CONVERSATIONS_FILE=./config/wechat-conversations.json
WECHAT_POLL_INTERVAL_MS=1000
WECHAT_SEND_INTERVAL_MS=300
# 留空时使用 native/WeChatBridge/publish/WeChatBridge.exe；先运行 npm run wechat:build
WECHAT_BRIDGE_PATH=
